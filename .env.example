# Salin menjadi .env (di-ignore git), lalu isi nilainya. Nilai secret tidak ditulis di file lain.

# Kunci API Gemini dari Google AI Studio, dipakai adapter provider LLM.
GEMINI_API_KEY=

# Kunci layanan yang dikirim backend aplikasi kasir di header X-API-Key.
SERVICE_API_KEY=

# Zona waktu toko (basis data IANA), dipakai untuk timestamp respons.
APP_TIMEZONE=Asia/Makassar

# Aktifkan dokumentasi OpenAPI (/docs dan /openapi.json).
DOCS_ENABLED=true
